spring:
  datasource:
    url: jdbc:mysql://localhost:3306/pay_service?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root
    password: 비밀번호 변경할곳
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      maximum-pool-size: 50
      minimum-idle: 10
      connection-timeout: 5000

  jpa:
    show-sql: true

  data:
    redis:
      host: localhost
      port: 6379

logging:
  level:
    org.springframework.security: DEBUG